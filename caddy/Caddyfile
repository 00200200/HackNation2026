# HTTPS for the public demo. Caddy gets and renews Let's Encrypt certificates for DOMAIN and
# www.DOMAIN (DOMAIN is set in .env and passed in by compose.prod.yaml) and redirects HTTP to HTTPS.
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy faktczyfejk-frontend:80
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# doc2json (repo HackNation2026-2): its container doc2json-web runs from /opt/doc2json on the
# shared Docker network `edge`, without published ports.
doc2json.pl {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy doc2json-web:80
}

www.doc2json.pl {
	redir https://doc2json.pl{uri} permanent
}
