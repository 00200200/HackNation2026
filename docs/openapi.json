{
  "openapi": "3.1.0",
  "info": {
    "title": "PRAWDOWID",
    "description": "Fact-checks a message or a link in Polish. Each checkable claim gets a verdict with the sources behind it: a quote, the publisher, the date and a link. When the evidence is not there, the verdict says so.\n\nThe web page and the Discord bot call `POST /api/checks`. A new channel does the same and names itself in `X-Channel`. The limit is 10/minute per client IP.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/checks": {
      "post": {
        "summary": "Check a text or a link",
        "description": "`input` is a message, a question or one `http`/`https` link. For a link the server fetches the page and checks its text. Allow up to 60 s for the answer.\n\nA check that could not run still returns `200`: `status` is then `technical_error`, `cannot_check` or `needs_clarification`, and `message` says why in Polish. An `input` that is empty, too long or not a valid link returns `422` with a Polish text in `detail[0].msg`; too many requests return `429`.\n\n`image` is an optional screenshot or photo in base64: a PNG, JPEG or WebP of at most 5 MB, 25 million pixels and 8000 px a side. A model reads its text and any visible date, and that text is checked like `input`, which may then be empty and is checked along with it. The answer's `image` shows the text that was read and `limitations` what an image check cannot tell. The image goes to the model provider as uploaded, metadata included; the API does not store it. Another type, a larger image or an image with a link returns `422`.",
        "operationId": "create_check_api_checks_post",
        "parameters": [
          {
            "name": "X-Channel",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "description": "The calling channel, logged with every check. Known values: demo, discord, web. Any other value is logged as `other`.",
              "default": "web",
              "title": "X-Channel"
            },
            "description": "The calling channel, logged with every check. Known values: demo, discord, web. Any other value is logged as `other`."
          },
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Session id from an earlier answer: 8 to 64 letters, digits or hyphens. The session's checks are kept together, and `DELETE /api/sessions/{session}` removes them. Without a valid id the server starts a new session.",
              "title": "X-Session-Id"
            },
            "description": "Session id from an earlier answer: 8 to 64 letters, digits or hyphens. The session's checks are kept together, and `DELETE /api/sessions/{session}` removes them. Without a valid id the server starts a new session."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The check result; `status` says whether the check ran.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResult"
                }
              }
            },
            "headers": {
              "X-Session-Id": {
                "description": "The session of this check: the one sent, or a new one. Send it back on the next check.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session}": {
      "get": {
        "summary": "Read Session",
        "description": "Every check record of a demo session, oldest first, as stored (masked).",
        "operationId": "read_session_api_sessions__session__get",
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{8,64}$",
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Read Session Api Sessions  Session  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Session",
        "description": "Delete every check record of a demo session (`deleted`), and take its questions out of\nthe moderator cases (`withdrawn`).",
        "operationId": "delete_session_api_sessions__session__delete",
        "parameters": [
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{8,64}$",
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Delete Session Api Sessions  Session  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sources": {
      "get": {
        "summary": "List Sources",
        "description": "Every source a check uses, for the page /zrodla. Plain def: the first call reads the\ncorpus file, so it runs in FastAPI's thread pool instead of blocking the event loop.",
        "operationId": "list_sources_api_sources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceList"
                }
              }
            }
          }
        }
      }
    },
    "/api/export/stix": {
      "post": {
        "summary": "Export Stix",
        "description": "The answer the client holds (the JSON of `POST /api/checks`) as a STIX 2.1 bundle\n(prawdowid/export.py). Masked again, nothing fetched; at most `export.MAX_ANSWER_BYTES` read.",
        "operationId": "export_stix_api_export_stix_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
