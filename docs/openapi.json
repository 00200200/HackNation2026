          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "count"
        ],
        "title": "ModeratorCase",
        "description": "The moderator's case this question was added to (scenario H, prawdowid/cases.py). Set only\nafter the case was written, so a channel says the question went to the moderator's queue only\nwhen it did."
      },
      "RateLimitError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "examples": [
              "Wysłano za dużo zapytań w krótkim czasie. Odczekaj minutę i spróbuj ponownie."
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "RateLimitError"
      },
      "SecurityEvent": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "prompt_injection",
            "title": "Kind",
            "default": "prompt_injection"
          },
          "location": {
            "type": "string",
            "enum": [
              "input",
              "page",
              "image",
              "source"
            ],
            "title": "Location"
          },
          "detector": {
            "type": "string",
            "enum": [
              "patterns",
              "model"
            ],
            "title": "Detector"
          }
        },
        "type": "object",
        "required": [
          "location",
          "detector"
        ],
        "title": "SecurityEvent",
        "description": "Instructions aimed at the model were found and ignored. Never carries their wording."
      },
      "Source": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "publisher": {
            "type": "string",
            "title": "Publisher"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type"
          },
          "fragment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fragment"
          },
          "snippet_only": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snippet Only"
          },
          "rating": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "stance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceStance"
              },
              {
                "type": "null"
              }
            ],
            "description": "The side this source stands on, from a quote found verbatim in it: 'potwierdza' (confirms the claim), 'przeczy' (contradicts it) or 'kontekst' (adds context, a data gap or a fact-checker's review of another claim). A fact-checker's rating of this claim gives its side through the rating. null when the verdict rules did not count the source: a headline alone, an older rating by the same fact-checker, or a source that says both."
          }
        },
        "type": "object",
        "required": [
          "title",
          "publisher",
          "published_at",
          "fetched_at",
          "url",
          "source_type"
        ],
        "title": "Source"
      },
      "SourceList": {
        "properties": {
          "lookups": {
            "items": {
              "$ref": "#/components/schemas/Lookup"
            },
            "type": "array",
            "title": "Lookups"
          },
          "web_search": {
            "items": {
              "$ref": "#/components/schemas/AllowedDomain"
            },
            "type": "array",
            "title": "Web Search"
          },
          "corpus": {
            "$ref": "#/components/schemas/CorpusSummary"
          },
          "catalogue": {
            "items": {
              "$ref": "#/components/schemas/CatalogueEntry"
            },
            "type": "array",
            "title": "Catalogue"
          }
        },
        "type": "object",
        "required": [
          "lookups",
          "web_search",
          "corpus",
          "catalogue"
        ],
        "title": "SourceList"
      },
      "SourceStance": {
        "type": "string",
        "enum": [
          "potwierdza",
          "przeczy",
          "kontekst"
        ],
        "title": "SourceStance",
        "description": "Which side of the claim a source stands on, for the evidence chain (#78)."
      },
      "Status": {
        "type": "string",
        "enum": [
          "ok",
          "technical_error",
          "cannot_check",
          "needs_clarification"
        ],
        "title": "Status",
        "description": "Outcome of the check itself. Never shown as a verdict."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verdict": {
        "type": "string",
        "enum": [
          "confirmed",
          "false",
          "misleading",
          "insufficient_evidence",
          "not_verifiable",
          "not_checked"
        ],
        "title": "Verdict",
        "description": "Outcome for one claim.\n\n`not_checked` is not a verdict: the time limit ran out, every source failed, or the\njudge model did not answer, and the claim's limitations say which."
      }
    }
  }
}
